# Copy this file to .env (never commit .env) and share the real values privately
# with your teammates. All services must use the SAME two secrets.
JWT_SECRET_KEY=replace-with-a-long-random-string
SERVICE_API_KEY=replace-with-another-long-random-string
JWT_EXPIRES_MINUTES=60
# DATABASE_PATH=database/security_system.db
# The team launcher sets TEAM_DATABASE_URI from the absolute DATABASE_PATH.
# Do not point the team launcher at an old fixture-only demo database.
# TABSH_ROUTE_PREFIX=/omar-tabsh

# Optional full-name URL prefix for Jad's routes
# JAD_ROUTE_PREFIX=/jad-moharam
