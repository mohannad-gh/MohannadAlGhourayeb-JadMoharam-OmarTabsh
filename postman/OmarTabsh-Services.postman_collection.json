    {
      "name": "Service 5 - Security Audit Logging (Omar Tabsh)",
      "item": [
        {
          "name": "Omar Tabsh - Create Log Record (Administrator)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{logs_url}}/logs",
            "description": "An administrator creates a log record manually.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"action\": \"SECURITY_REVIEW\",\n  \"description\": \"Manual note: quarterly access review completed\",\n  \"severity\": \"Information\",\n  \"related_service\": \"Audit Logging\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"log_id\", pm.response.json().data.log_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Omar Tabsh - Create Log Record (Trusted Service Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Key",
                "value": "{{service_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{logs_url}}/logs",
            "description": "Shows how services send events with the X-Service-Key header instead of a user token. Real automatic events come from the other services.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": null,\n  \"action\": \"SERVICE_KEY_TEST\",\n  \"description\": \"Manual test of the inter-service X-Service-Key path (not a real system event)\",\n  \"severity\": \"Information\",\n  \"related_service\": \"Audit Logging\"\n}"
            }
