{
  "info": {
    "name": "Omar Tabsh - Threat Intelligence, Audit Logging and Security Reports",
    "description": "Services 4, 5 and 6 of the Security Incident Detection and Response Management System, developed by Omar Tabsh.\n\nSet the *_token variables to tokens from POST /users/login (or `python -m scripts.dev_token` during development) and service_key to SERVICE_API_KEY from .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Service 4 - Threat Intelligence (Omar Tabsh)",
      "item": [
        {
          "name": "Omar Tabsh - Add Threat Indicator (IP Address)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{threats_url}}/threats",
            "description": "Administrator adds a malicious IP address. Validated with Python's ipaddress module.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threat_type\": \"IP Address\",\n  \"threat_value\": \"185.220.101.45\",\n  \"description\": \"Tor exit node seen in SSH brute-force attempts\",\n  \"severity\": \"High\",\n  \"source\": \"AbuseIPDB\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"threat_id\", pm.response.json().data.threat_id);"
                ]
              }
            }
          ]
        },
